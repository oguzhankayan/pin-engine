# Images: Raywake API key with the `generate` and `jobs:read` scopes.
# https://raywake.si/api-keys?utm_source=github&utm_medium=pin-engine&utm_campaign=oss&utm_content=env
RAYWAKE_API_KEY=

# Publishing: Zernio API key (https://zernio.com), with your Pinterest account connected in Zernio.
ZERNIO_API_KEY=

# Optional
# PIN_TIMEZONE=Europe/Istanbul
# RAYWAKE_MODEL=openai/gpt-image-2.5/sunburst/text-to-image
# RAYWAKE_EDIT_MODEL=openai/gpt-image-2.5/sunburst/edit
